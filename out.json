                {
                    "id": "732485f54-97a4-00c9-d724-184af852abc",
                    "name": "inst",
                    "type": "markdown",
                    "columnSpan": 3,
                    "template": "If YES, provide brief advice and/or extended brief advice. The patient is on the higher risk category level of drinking or in harmful use of alcohol."
                }
