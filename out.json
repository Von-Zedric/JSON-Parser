        },
        {
            "id": "ab66021f0-36a4-7e99-6c2e-74fef859310",
            "name": "alcohol-intake-1",
            "type": "field-group",
            "title": "Q1 Have you ever consumed alcohol?",
            "fields": [
                {
                    "id": "b0cc5dde0-6d64-76c9-2884-4bf4ef190bf",
                    "name": "alcohol-opts",
                    "type": "dropdown",
                    "columnSpan": 2,
                    "options": [
                        {
                            "label": "Never consumed",
                            "value": "0"
                        },
                        {
                            "label": "Yes, drinks alcohol",
                            "value": "1"
                        }
                    ],
                    "label": ""
                },
                {
                    "id": "876a78a72-4e94-f3c9-ea01-04faa1702b9",
                    "name": "inst-1",
                    "type": "markdown",
                    "columnSpan": 3,
                    "template": "If YES, proceed using AUDIT SCREENING TOOL (Form 2) to         alcohol consumption and alcohol problems"
                },
                {
                    "id": "a07d48943-39e4-520a-613f-bafe3d1b1a4",
                    "name": "inst-2",
                    "type": "markdown",
                    "columnSpan": 3,
                    "template": "If NO, congratulate the patient.         The patient is at a lower risk of drinking alcohol"
                }
            ],
            "columns": 8
        },
        {
            "id": "3b9701ad0-cd24-3899-8b46-89191a532b4",
            "name": "alcohol-intake-2",
            "type": "field-group",
            "title": "Q2 Do you drink 5 or more standard drinks for men, and 4 or more for women (in one sitting/occassion) in the past year?",
            "fields": [
                {
                    "id": "d91510512-5ec4-b07b-cfa5-c15b21d2226",
                    "name": "alcohol-opts",
                    "type": "dropdown",
                    "columnSpan": 1,
                    "options": [
                        {
                            "label": "Yes",
                            "value": "1"
